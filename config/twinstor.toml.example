[node]
name = "node-a"
peer = "node-b"

[network]
peer_address = "10.0.0.2"
drbd_port = 7789

[storage]
drbd_resource = "data"
backing_device = "/dev/disk/by-id/ata-EXAMPLE_SSD_1TB_SN0000-part4"
drbd_device = "/dev/drbd0"

[iscsi]
target_iqn = "iqn.2026-01.com.xcp-ng:twinstor-data"
# Both nodes must use the same lun_serial so multipath recognizes
# the LUN as the same device regardless of which node is serving it.
lun_serial = "twinstor0001"
# portal_port = 3260
# CHAP authentication (generated by twinstor setup)
chap_user = "twinstor"
chap_password = "randompassword"
initiator_iqns = ["iqn.1993-08.org.debian:01:node-a", "iqn.1993-08.org.debian:01:node-b"]

[timers]
# How often to check DRBD and disk health (ms)
# poll_interval_ms = 1000

[failback]
# Arbitrated mode only. Whether the daemon may move replication back to the
# direct link BY ITSELF once the link has been stable past the (escalating)
# hold: a brief guarded dance on the side with fewer VMs (seconds; consumers
# ride multipath through it). `false` still steers natural reconnects and
# still honors `twinstor failback-replication`; it only disables the
# daemon-initiated dance.
# auto = true

[ha]
# Whether the daemon may recover a stuck XHA re-admission BY ITSELF. After a
# fence storm, two staggered HA-daemon restarts can deadlock on each other's
# stale liveset claims ("HA daemon failed to start" from xe, for minutes);
# the daemon detects the signature and runs the safe recovery: quiesce both
# HA daemons >90s, then a synchronized re-arm (timeout-preserving). Only runs
# when storage is fully healthy and the peer is reachable; capped at once per
# hour. `false` keeps the detection + alert (naming the manual runbook) and
# only disables the automated recovery.
# readmission_assist = true

# Auto-heal an isolated pool master by DURABLE STORAGE STAND-DOWN (arbitrated
# mode only; inert on a single-path/fate-shared deployment). When this master
# loses its client/switch network while the peer is still alive AND up to date
# on the direct replication link, its VMs there are already unreachable to
# clients. After a confirmed ~10-minute window it makes its OWN storage
# unavailable (stops its target, logs out its iSCSI sessions, demotes) so those
# VMs cannot write via any path and HA restarts them on the reachable peer; it
# stays parked across reboots while still isolated and rejoins on its own when
# its client network stably returns. Data-safe by construction (it only ever
# removes a writer) and gated on the peer being up to date. `false` keeps the
# detect-and-alert behavior only. Replaces the withdrawn reboot-based
# self-fence, so this key is deliberately NOT `self_fence_isolated_master`.
# self_standdown_isolated_master = true

[reboot_drain]
# Host-side reboot-safety backstop (twinstor-reboot-drain.service). During the
# shutdown transaction it holds THIS host's reboot only when it is the last
# UpToDate replica and the peer is still resyncing, so a rolling reboot / yum
# reboot / kernel-update reboot / RPU cannot take down the only current copy
# mid-catch-up and strand the rebuild. Every safe state (the returning
# SyncTarget, or a peer that already holds a current copy) proceeds instantly,
# and it fails open on any error, so it never wedges a reboot. Complements the
# daemon's twinstor-synced advertisement that paces XO RPU at the orchestrator
# layer; this covers every clean reboot XO never sees.
# enabled = true
#
# Upper bound on the hold, in seconds. A rolling-reboot delta resync usually
# finishes well inside this; a full rebuild (post disk-swap) will not, so the cap
# turns that case into a loud, alerted proceed instead of a wedged host. Override
# a live hold from another shell with: touch /run/twinstor/allow-unsafe-reboot
# max_secs = 600
